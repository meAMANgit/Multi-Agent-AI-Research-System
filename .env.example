# ==============================================================================
# ResearchCore AI - Multi-Agent Deep Research System Configuration
# ==============================================================================

# LLM Provider Configuration
# Options: google, openai, anthropic, groq, ollama, mock
DEFAULT_LLM_PROVIDER=google
DEFAULT_MODEL_NAME=gemini-2.5-flash

# API Keys (Set at least one or use 'mock' for local offline testing)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Ollama Configuration (For offline local execution)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b

# Search Tool API Keys (Optional: DuckDuckGo, Wikipedia & ArXiv require no keys)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Multi-Agent Workflow Execution Settings
MAX_RESEARCH_ITERATIONS=3
QUALITY_SCORE_THRESHOLD=85
MAX_SEARCH_RESULTS_PER_QUERY=6
REQUEST_TIMEOUT_SECONDS=30
CRAWLER_USER_AGENT=ResearchCoreAI/2.0 (DeepResearchBot; +https://github.com/meAMANgit/Multi-Agent-AI-Research-System)

# API Server Settings
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL=INFO
